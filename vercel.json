{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/work/:slug",
      "destination": "/project.html?p=:slug"
    },
    {
      "source": "/case/:slug",
      "destination": "/project.html?p=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "(?<slug>[a-z]+)"
        }
      ],
      "destination": "/work/:slug",
      "permanent": false
    }
  ]
}